{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>solar-cooker-UHasselt/.github:renovate-config"],
  "packageRules": [
    {
      "description": "Python in check.yml follows the KiBot image, not the latest release",
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "KiBot image tags are <KiBot version>-<build>_k<KiCad>_d<Debian>, newer means a higher KiBot version or build",
      "matchPackageNames": ["ghcr.io/inti-cmnb/kicad10_auto"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)_k[\\d.]+_d[\\d.]+$",
      "groupName": "KiBot image"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "KiBot image of the CLI, kept equal to kibot.yml's (a test checks it)",
      "managerFilePatterns": ["/^cli/kicad_ci/kibot\\.py$/"],
      "matchStrings": ["IMAGE = \"(?<depName>ghcr\\.io/inti-cmnb/kicad10_auto):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ]
}
